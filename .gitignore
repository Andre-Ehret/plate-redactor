# --- Project artefacts (never commit) ---
# Synthetic images & labels, real plate photos
/data/*
!/data/.gitkeep
# Checkpoints, exported .tflite, weights, logs
/models/*
!/models/.gitkeep
*.tflite
*.ckpt
*.pt
*.pth
*.h5
*.onnx
*.weights

# Real plate photos — never commit, regardless of location
**/real_plates/
**/real/

# --- Python ---
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.eggs/
build/
dist/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# --- Notebooks ---
# Commit the .ipynb scripts themselves; ignore Jupyter's autosave checkpoints
# and any executed run outputs (real checkpoints already covered by /models/*).
.ipynb_checkpoints/

# --- Virtual environments ---
.venv/
venv/
env/
ENV/

# --- Editors / OS ---
.vscode/
.idea/
*.swp
.DS_Store
